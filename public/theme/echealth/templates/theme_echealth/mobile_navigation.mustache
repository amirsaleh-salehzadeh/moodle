{{!
    Mobile primary navigation using Boost's focus-managed drawer behavior.
}}
{{< theme_boost/drawer }}
    {{$id}}theme_boost-drawers-primary{{/id}}
    {{$drawerclasses}}drawer drawer-left drawer-primary ec-mobile-navigation-drawer{{/drawerclasses}}
    {{$drawercloseonresize}}1{{/drawercloseonresize}}
    {{$drawerheading}}
        <a href="{{{ config.homeurl }}}" title="{{output.echealth_department_name}}" class="aabtn text-reset d-flex align-items-center h-100">
            {{{ output.echealth_brand_logo }}}
            <span class="ec-mobile-brand-name">{{output.echealth_department_name}}</span>
        </a>
    {{/drawerheading}}
    {{$drawercontent}}
        {{{ output.echealth_mobile_navigation }}}
    {{/drawercontent}}
    {{$drawerstate}}show-drawer-primary{{/drawerstate}}
{{/ theme_boost/drawer}}
{{#js}}
require(['theme_echealth/navigation'], function(Navigation) {
    Navigation.init();
});
{{/js}}
