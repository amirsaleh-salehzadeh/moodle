{{!
    @template theme_boost/login
    Eastern Cape Health login page with Moodle's native login form.
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}

<div id="page-wrapper">
    {{{ output.standard_top_of_body_html }}}

    <header class="echealth-masthead">
        <div class="echealth-government-stripe" aria-hidden="true"></div>
        <div class="echealth-brand-inner container-fluid">
            <a href="{{{ config.homeurl }}}" class="echealth-brand-mark" aria-label="{{#str}}departmentname, theme_echealth{{/str}}">
                {{#pix}}ec-health-logo, theme_echealth, {{#str}}departmentname, theme_echealth{{/str}}{{/pix}}
            </a>
            <div class="echealth-brand-copy">
                <strong class="echealth-department-name">{{#str}}departmentname, theme_echealth{{/str}}</strong>
                <span class="echealth-portal-name">{{#str}}portalname, theme_echealth{{/str}}</span>
            </div>
        </div>
    </header>

    <div id="page" class="mt-0">
        {{> core/login_layout }}
    </div>
    {{> theme_boost/footer }}
</div>

</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
  M.util.js_complete('theme_boost/loader');
});
{{/js}}
