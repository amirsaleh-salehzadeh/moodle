{{!
    @template core/login_panel
    Eastern Cape Department of Health LMS portal introduction.
}}
<div class="login-layout-left-content echealth-login-introduction">
    <p class="echealth-login-kicker">{{#str}}departmentname, theme_echealth{{/str}}</p>
    <h1 class="h2 mb-3">{{#str}}loginheading, theme_echealth{{/str}}</h1>
    <p class="echealth-login-intro">{{#str}}loginintro, theme_echealth{{/str}}</p>

    <section aria-labelledby="echealth-about-heading">
        <h2 id="echealth-about-heading">{{#str}}aboutdepartment, theme_echealth{{/str}}</h2>
        <p>{{#str}}aboutdepartmenttext, theme_echealth{{/str}}</p>
    </section>

    <section class="echealth-mission" aria-labelledby="echealth-vision-heading">
        <h2 id="echealth-vision-heading">{{#str}}departmentvision, theme_echealth{{/str}}</h2>
        <p>{{#str}}departmentvisiontext, theme_echealth{{/str}}</p>
    </section>

    <section aria-labelledby="echealth-mission-heading">
        <h2 id="echealth-mission-heading">{{#str}}departmentmission, theme_echealth{{/str}}</h2>
        <p>{{#str}}departmentmissiontext, theme_echealth{{/str}}</p>
    </section>

    <p class="echealth-portal-purpose">{{#str}}portalpurpose, theme_echealth{{/str}}</p>
    <a class="echealth-department-link" href="https://www.echealth.gov.za/" target="_blank" rel="noopener noreferrer">
        {{#str}}visitdepartment, theme_echealth{{/str}}
    </a>
</div>
